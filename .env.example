# =============================================================================
#  Environment variables
# =============================================================================
#  RULE: Vite compiles every `VITE_`-prefixed variable that is REFERENCED in
#  frontend code into the public browser bundle. Anything with a `VITE_` prefix
#  must be considered PUBLIC. Never give a secret a `VITE_` name.
# =============================================================================

# ── Public client config (safe to ship in the bundle) ───────────────────────
# Firebase Web config keys are designed to be public (secured by Firestore/
# Storage rules + App Check), so a VITE_ prefix is correct here.
VITE_API_KEY=your_firebase_web_api_key
VITE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PROJECT_ID=your-project-id
VITE_STORAGE_BUCKET=your-project.appspot.com
VITE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_APP_ID=your_app_id
VITE_PUBLIC_CATALOGUE_URL=https://your-public-catalogue-url

# ── WhatsApp / BotMasterSender ───────────────────────────────────────────────
# The base URLs are the public API host, so exposing them is fine.
# ⚠ VITE_BMS_PARTNER_UID currently ships in the public bundle. It should be
#   moved server-side behind the `botmasterProxy` Cloud Function and this var
#   removed from the client. See SECURITY.md.
VITE_BMS_BASE_URL=https://api.botmastersender.com/api
VITE_BMS_BASE_SEND_URL=https://api.botmastersender.com/api/v1
# Legacy: only used by the fallback path. Remove after the proxy cutover below.
VITE_BMS_PARTNER_UID=your_bms_partner_uid
# Set to the deployed botmasterRegister function URL to route registration
# through the server-side proxy (then the partner UID never ships to the browser).
# e.g. https://<region>-<project>.cloudfunctions.net/botmasterRegister
VITE_BMS_REGISTER_PROXY_URL=

# Server-only (Firebase Functions secrets — NOT client vars):
#   firebase functions:secrets:set BMS_PARTNER_UID
#   firebase functions:secrets:set BMS_BASE_URL      (e.g. https://api.botmastersender.com/api)

# ── Server-only secrets — NEVER prefix with VITE_ ────────────────────────────
# These are read ONLY by backend code (Firebase Functions / Express) via
# process.env, and must be called from a server-side proxy endpoint — never
# imported into the React app. Set them as Firebase Functions secrets in prod:
#   firebase functions:secrets:set ICICI_SECRET_KEY   (etc.)
ICICI_SECRET_KEY=your_icici_secret_key
ICICI_MERCHANT_ID=your_icici_merchant_id
ICICI_AGGREGATOR_ID=your_icici_aggregator_id
ICICI_SALE_API_URL=https://icici-sale-api-url
ICICI_COMMAND_API_URL=https://icici-command-api-url
EWAY_API_URL=https://eway-api-url
EWAY_API_KEY=your_eway_api_key

# ── Backend (Express SSR server) ─────────────────────────────────────────────
# FUNCTIONS_BASE_URL=https://your-region-your-project.cloudfunctions.net
