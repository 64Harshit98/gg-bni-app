rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && request.auth.token.companyId == companyId;
    }
    
    function isSelf(companyId, userId) {
      return isCompanyMember(companyId) && request.auth.uid == userId;
    }

    // --- Master Admin Access ---
    match /{document=**} {
      allow read, write: if request.auth.uid == "6vwZ1HRqX7VSnh5KP4JW0TKeuZm2";
      allow read, write: if request.auth.uid == "1AKioGfop8PmHhry6uXOz8Rw6qT2";
      }
    match /agents/{userId} {
      allow read, write, create, update: if request.auth != null && request.auth.uid == userId;
    }
    match /commissions/{commissionId} {
      allow read: if request.auth != null && resource.data.agentId == request.auth.uid;
    }

    match /payoutRequests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.agentId == request.auth.uid;
    }

    // --- Public Leads (Sign Up) ---
    match /leads/{leadId} {
      allow create, update: if true; 
      allow read: if request.auth != null; 
    }
    match /contacts/{contactId} {
      allow create: if true; // Anyone can submit a form
      allow read, update, delete: if false; // Only admins can view/edit them via console
    }

    // --- Tenant Data (Company Specific) ---
    match /companies/{companyId} {
      
      // Default rule: Must be a member to read/update the company doc itself
      allow read: if true;
      allow update: if isCompanyMember(companyId);
      allow read: if request.auth != null && resource.data.referralDetails.referrerId == request.auth.uid;

      // =========================================================
      // PUBLIC READ ACCESS (For QR Bill Download)
      // =========================================================
      
      // 1. Sales: Public needs to read the invoice details
      match /sales/{document=**} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }

      // 3. Business Info: Public needs Company Address/Logo for the PDF header
      match /business_info/{document=**} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }

      // 4. Sales Settings: Public needs to know if "Salesman Name" should be hidden
      match /settings/sales-settings {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }
      match /settings/bill {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }
      match /settings/{document=**} {
          allow read: if true; 
      }
      
      // =========================================================
      // AUTHENTICATED ONLY SECTIONS
      // =========================================================

      match /users/{userId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isSelf(companyId, userId);
        allow delete: if false;
      }
      
      match /users/{userId}/artifacts/{appId}/{collectionId}/{document=**} {
        allow read, write: if isSelf(companyId, userId);
      }
      
      // General Settings (catch-all for other settings like Purchase, etc.)
      match /settings/{settingId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /counters/{counterId} {
        allow read, write: if isCompanyMember(companyId);
      }
      
      match /counter/{counterId} {
        allow read, write: if isCompanyMember(companyId);
      }
      
      match /attendance/{document=**} {
        allow read, write: if isCompanyMember(companyId);
      }
      

      // Public can read items that are listed
      match /items/{itemId} {
        allow read: if true;
        // Allows public to decrement stock but NOT change price/name
        allow update: if true; 
        allow write: if isCompanyMember(companyId);
      }

      // 2. Orders: Public needs to CREATE, READ, and DELETE (for upcoming orders)
      match /Orders/{orderId} {
        allow create, read, delete: if true; 
        allow update: if true; 
      }

      // 3. Catalogue Settings: Ensure this is EXACTLY like this
      match /settings/catalogue-sales-settings {
        allow read: if true;
        allow update: if true; // CRITICAL for the transaction to increment voucher
      }
      
      // 4. Notify Requests: You'll need this for the "Notify Me" button
      match /NotifyRequests/{requestId} {
        allow read, create, update: if true;
      }
      
      // Public can read item groups (categories)
      match /itemGroups/{groupId} {
        allow read: if true;
      }
      
      match /AuthorizedUser/{userId} {
        allow read: if true;
        allow create: if true;
      }
      
      match /permissions/{role} {
         allow read: if isCompanyMember(companyId);
         allow write: if isCompanyMember(companyId); 
      }

      // Purchases remain private
      match /purchases/{document=**} {
        allow read, write: if isCompanyMember(companyId);
      }

      // Catch-all for any other collections not explicitly listed above
      match /{collection}/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // --- Global Data ---
    match /permissions/{role} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /CompanyID/{counterId} {
      allow read, write: if false;
    }
  }
}