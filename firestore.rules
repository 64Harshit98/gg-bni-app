rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && request.auth.token.companyId == companyId;
    }
    
    function isSelf(companyId, userId) {
      return isCompanyMember(companyId) && request.auth.uid == userId;
    }

    // --- Master Admin Access ---
    match /{document=**} {
      allow read, write: if request.auth.uid == "1AKioGfop8PmHhry6uXOz8Rw6qT2";
    }

    // --- Public Leads (Sign Up) ---
    match /leads/{leadId} {
      allow create, update: if true; 
      allow read: if request.auth != null; 
    }
    match /contacts/{contactId} {
      allow create: if true; // Anyone can submit a form
      allow read, update, delete: if false; // Only admins can view/edit them via console
    }

    // --- Tenant Data (Company Specific) ---
    match /companies/{companyId} {

      // Company doc: authenticated members only
      allow get: if isCompanyMember(companyId);
      allow update: if isCompanyMember(companyId);

      // =========================================================
      // PUBLIC READ ACCESS (For QR Bill Download & Catalogue)
      // allow get = single-document fetch only; list/query requires auth.
      // This prevents unauthenticated enumeration of all records.
      // =========================================================

      // 1. Sales: QR share link fetches a specific invoice by ID
      match /sales/{saleId} {
        allow get: if true;
        allow list, write: if isCompanyMember(companyId);
      }

      // 2. Business Info: PDF header needs company address/logo
      match /business_info/{docId} {
        allow get: if true;
        allow list, write: if isCompanyMember(companyId);
      }

      // 3. Sales Settings: PDF rendering needs tax/salesman display config
      match /settings/sales-settings {
        allow get: if true;
        allow write: if isCompanyMember(companyId);
      }

      // 4. Bill settings: public PDF download
      match /settings/bill {
        allow get: if true;
        allow write: if isCompanyMember(companyId);
      }

      // =========================================================
      // AUTHENTICATED ONLY SECTIONS
      // =========================================================

      match /users/{userId} {
        allow read: if isCompanyMember(companyId);
        allow create, update: if isSelf(companyId, userId);
        allow delete: if false;
      }

      match /users/{userId}/artifacts/{appId}/{collectionId}/{document=**} {
        allow read, write: if isSelf(companyId, userId);
      }

      // General Settings catch-all
      match /settings/{settingId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /counters/{counterId} {
        allow read, write: if isCompanyMember(companyId);
      }

      // Legacy 'counter' path — read-only during migration period
      match /counter/{counterId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false;
      }

      match /attendance/{document=**} {
        allow read, write: if isCompanyMember(companyId);
      }

      // Items: public get for catalogue browsing; only members can write
      match /items/{itemId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      // Catalogue Orders: public can place and track their own orders
      match /Orders/{orderId} {
        allow create, read: if true;
        allow delete, update: if isCompanyMember(companyId);
      }

      // Catalogue Sales Settings: members write; public can only read the doc
      match /settings/catalogue-sales-settings {
        allow get: if true;
        allow write: if isCompanyMember(companyId);
      }

      // Notify Requests: public can create/read (no PII write risk)
      match /NotifyRequests/{requestId} {
        allow read, create: if true;
        allow update, delete: if isCompanyMember(companyId);
      }

      // Item Groups: public get for catalogue category browsing
      match /itemGroups/{groupId} {
        allow get: if true;
        allow list, write: if isCompanyMember(companyId);
      }

      match /AuthorizedUser/{userId} {
        allow read, create: if true;
        allow update, delete: if isCompanyMember(companyId);
      }

      match /permissions/{role} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      // Purchases remain private
      match /purchases/{document=**} {
        allow read, write: if isCompanyMember(companyId);
      }

      // Catch-all for any other collections not explicitly listed above
      match /{collection}/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // --- Global Data ---
    match /permissions/{role} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    match /CompanyID/{counterId} {
      allow read, write: if false;
    }
  }
}