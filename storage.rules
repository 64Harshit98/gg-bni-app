rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allows read/write/delete access to any user who is logged in
      allow read, write: if request.auth != null; 
    }
    match /{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.contentType.matches('application/pdf'); // Only PDFs
    }
    // Existing rule for Items
    match /companies/{companyId}/items/{itemId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // --- ADD THIS NEW RULE FOR USERS ---
    match /companies/{companyId}/users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /companies/{companyId}/AuthorizedUser/{fileName} {
      
      // OPTION A: If the user MUST be logged in to submit this form
      allow read, write: if request.auth != null;
      
      // OPTION B: If this is a public lead-generation popup (user is NOT logged in yet)
      // Note: This allows anyone to upload, so you may want to add file size/type restrictions later.
      allow read, write: if true; 
    }
    
  }
}